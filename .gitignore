# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
.utmp/
/visualizer/[Ll]ibrary/
/visualizer/[Tt]emp/
/visualizer/[Oo]bj/
/visualizer/[Bb]uild/
/visualizer/[Bb]uilds/
/visualizer/[Ll]ogs/
/visualizer/[Uu]ser[Ss]ettings/
/visualizer/*.log

# By default unity supports Blender asset imports, *.blend1 blender files do not need to be commited to version control.
/visualizer/*.blend1
/visualizer/*.blend1.meta

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/visualizer/[Mm]emoryCaptures/

# Recordings can get excessive in size
/visualizer/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/visualizer/[Aa]ssets/Plugins/Editor/JetBrains*
# Jetbrains Rider personal-layer settings
/visualizer/*.DotSettings.user

# Visual Studio cache directory
/visualizer/.vs/

# Gradle cache directory
/visualizer/.gradle/

# Autogenerated VS/MD/Consulo solution and project files
/visualizer/ExportedObj/
/visualizer/.consulo/
/visualizer/*.csproj
/visualizer/*.unityproj
/visualizer/*.sln
/visualizer/*.suo
/visualizer/*.tmp
/visualizer/*.user
/visualizer/*.userprefs
/visualizer/*.pidb
/visualizer/*.booproj
/visualizer/*.svd
/visualizer/*.pdb
/visualizer/*.mdb
/visualizer/*.opendb
/visualizer/*.VC.db

# Unity3D generated meta files
/visualizer/*.pidb.meta
/visualizer/*.pdb.meta
/visualizer/*.mdb.meta

# Unity3D generated file on crash reports
/visualizer/sysinfo.txt

# Mono auto generated files
/visualizer/mono_crash.*

# Builds
/visualizer/*.apk
/visualizer/*.aab
/visualizer/*.unitypackage
/visualizer/*.unitypackage.meta
/visualizer/*.app

# Crashlytics generated file
/visualizer/crashlytics-build.properties

# TestRunner generated files
/visualizer/InitTestScene*.unity*

# Addressables default ignores, before user customizations
/visualizer/ServerData
/visualizer/[Aa]ssets/StreamingAssets/aa*
/visualizer/[Aa]ssets/AddressableAssetsData/link.xml*
/visualizer/[Aa]ssets/Addressables_Temp*
# By default, Addressables content builds will generate addressables_content_state.bin
# files in platform-specific subfolders, for example:
# /Assets/AddressableAssetsData/OSX/addressables_content_state.bin
/visualizer/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files
/visualizer/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/visualizer/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/visualizer/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/visualizer/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated scenes by play mode tests
/visualizer/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Generated by Cargo
# will have compiled files and executables
debug
target
/parser/NetVis/pcap2ch/target/deps
/parser/NetVis/pcap2ch/target/examples
/parser/NetVis/pcap2ch/target/incremental

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
.idea/

# debug/config files for Unity and Vistual Studio
/visualizer/test_BackUpThisFolder_ButDontShipItWithYourGame/
/visualizer/test_BurstDebugInformation_DoNotShip/
/visualizer/Temp/
/visualizer/Logs/
/visualizer/Library/
/visualizer/Assets/
/visualizer/Assets/Packages/
/visualizer/.vs/
/visualizer/obj/
/visualizer/UserSettings/
/visualizer/*.sln
/visualizer/*.csproj
/visualizer/.idea/
/visualizer/.vscode/
/visualizer/.vsconfig
/visualizer/*.unityproj
/visualizer/*.suo
/visualizer/*.tmp
/visualizer/*.user
/visualizer/*.userprefs
/visualizer/*.pidb
/visualizer/*.booproj
/visualizer/*.svd
/visualizer/*.pdb
/visualizer/*.mdb
/visualizer/*.opendb
/visualizer/*.VC.db
/visualizer/*app.config
/visualizer/*packages.config
/.vs/
# whitelist the package config files so unity downloads packages automatically
!/visualizer/Packages/manifest.json
!/visualizer/Packages/packages-lock.json

# OS Generated Junk
*/.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# zeek logs (push directory but not contents)
/parser/zeek-logs/*
