        <dependency id="NodaTime" version="3.2.2" exclude="Build,Analyzers" />
        <dependency id="System.Net.Http" version="4.3.4" exclude="Build,Analyzers" />
        <dependency id="System.Text.Json" version="9.0.2" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net6.0">
